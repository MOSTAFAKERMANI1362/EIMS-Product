  },
  "versionSemantics": {
    "businessIdeaRevisionSeparatedFromTechnicalConcurrencyVersion": true,
    "technicalStateMutationVersionIncrementExactlyBy": 1,
    "technicalAssessmentDecisionVersionIncrementExactlyBy": 1,
    "businessIdeaRevisionIncrementPolicy": {
      "APPROVE": 0,
      "RETURN": 1,
      "HOLD": 0,
      "REJECT": 0
    },
    "rationale": "Frozen v6.360 increments Idea business revision only on RETURN. Production still increments a separate technical concurrency/state-mutation version on every successful final-decision mutation."
