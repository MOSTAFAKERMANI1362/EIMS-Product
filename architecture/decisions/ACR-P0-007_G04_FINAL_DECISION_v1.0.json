      "profileSnapshotHash",
      "ruleSet",
      "hardConditionMappingVersion",
      "gateScore",
      "dataReadiness",
      "ruleCheckResults",
      "specialistOutcomeSummary",
      "committeeSnapshotIdWhenApplicable",
      "committeeVersionWhenApplicable",
      "committeeApprovalResultWhenApplicable",
      "sodResult",
      "sodExceptionPolicyWhenApplicable",
      "timestamp",
      "correlationId"
    ],
    "historicalDecisionMayBeOverwritten": false
  },
  "returnInvalidation": {
    "trigger": "RETURN",
    "ideaVersionMustIncrementExactlyBy": 1,
    "oldActiveEvaluationPlans": "SUPERSEDED",
    "oldPendingG04Assessments": "SUPERSEDED",
    "oldTechnicalAssessment": "STALE",
    "oldStructuredIdeaEvaluation": "STALE",
    "supersessionReason": "Idea version changed",
    "newVersionRequiresFreshEvaluationContext": true
  },
  "transactionBoundary": {
    "singleLogicalTransaction": [
      "IdeaStateAndVersion",
      "G04AssessmentDecisionAndClosure",
      "ImmutableFinalDecisionEvidence",
      "ReturnVersionSupersessionMetadataWhenApplicable",
