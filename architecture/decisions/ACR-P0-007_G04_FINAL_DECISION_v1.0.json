    }
  ],
  "command": {
    "id": "g04.final-decision",
    "method": "POST",
    "endpoint": "/commands/g04/{assessmentId}/final-decision",
    "targetAggregate": "Idea",
    "requiredRole": "IDEA_DECISION",
    "runtimePromotionInThisAcr": false
  },
  "authority": {
    "identitySource": "P3_AUTHENTICATED_AUTHORITY_ACTOR",
    "exactAuthorityAssignmentRequired": true,
    "singleEffectiveRoleRequired": "IDEA_DECISION",
    "scopeMustContainIdeaScope": true,
    "clientMaySupplyPersonRoleScopeOrAssignmentAuthority": false,
    "committeeMemberMayBeFinalDeciderForSameAssessment": false,
    "committeeAndFinalDecisionAuthoritySeparated": true,
    "evaluatorConflictPolicy": {
      "appliesToOutcome": "APPROVE",
      "default": "DENY",
      "allowedException": "ALLOW_WITH_AUDIT",
      "exceptionMustBeFrozenGovernancePolicy": true,
      "exceptionRequiresExplicitAuditEvidence": true
    }
  },
  "context": {
    "assessmentStateRequired": "PENDING",
    "exactAssessmentIdRequired": true,
    "exactIdeaIdRequired": true,
    "assessmentIdeaVersionMustEqualCurrentIdeaVersion": true,
    "exactEvaluationPlanRequired": true,
    "planIdeaVersionMustEqualCurrentIdeaVersion": true,
    "staleOrSupersededPlanDenied": true,
    "staleOrSupersededAssessmentDenied": true,
    "optimisticConcurrencyRequired": true,
    "idempotencyRequired": true
  },
  "outcomes": [
    {
      "value": "APPROVE",
      "ideaStateAfter": "APPROVED",
      "ideaVersionIncrement": false,
      "assessmentStateAfter": "DECIDED",
      "eventType": "IdeaApprovedForPortfolio.v1",
      "eventIdentityStatus": "FROZEN_EXISTING",
      "positiveApprovalGateRequired": true
    },
    {
      "value": "RETURN",
      "ideaStateAfter": "RETURNED",
      "ideaVersionIncrement": true,
      "assessmentStateAfter": "DECIDED",
      "eventType": "IdeaReturnedFromG04.v1",
      "eventIdentityStatus": "POST_FREEZE_STABILIZED",
      "positiveApprovalGateRequired": false
    },
    {
      "value": "HOLD",
      "ideaStateAfter": "HOLD",
      "ideaVersionIncrement": false,
      "assessmentStateAfter": "DECIDED",
      "eventType": "IdeaHeldAtG04.v1",
      "eventIdentityStatus": "POST_FREEZE_STABILIZED",
      "positiveApprovalGateRequired": false,
      "reviewDateRequired": true
    },
    {
      "value": "REJECT",
      "ideaStateAfter": "REJECTED",
      "ideaVersionIncrement": false,
      "assessmentStateAfter": "DECIDED",
      "eventType": "IdeaRejectedAtG04.v1",
      "eventIdentityStatus": "POST_FREEZE_STABILIZED",
      "positiveApprovalGateRequired": false
    }
  ],
  "decisionInput": {
    "commentRequired": true,
    "commentMinLength": 15,
    "holdReviewDateRequired": true,
    "clientMayChooseEventIdentity": false,
    "clientMayChooseRuleProfileOrFrozenEvidence": false
  },
  "approvalOnlyRuleSuite": {
    "appliesOnlyWhenOutcome": "APPROVE",
    "negativeOutcomesMayProceedWhenApprovalRulesFail": ["RETURN", "HOLD", "REJECT"],
    "checks": [
      {
        "id": "PROFILE_SNAPSHOT_VALID",
        "required": true,
        "rule": "Use the exact frozen decision profile/rule evidence; never substitute a later active profile."
      },
      {
        "id": "GATE_SCORE_THRESHOLD",
        "required": true,
        "rule": "Calculated gate score must be greater than or equal to the frozen profile passThreshold."
      },
      {
        "id": "DATA_READINESS_THRESHOLD",
        "required": true,
        "rule": "Data readiness must be greater than or equal to the frozen profile dataThreshold."
      },
      {
        "id": "BASE_NEED_PRESENT",
        "required": true,
        "rule": "Idea must reference a base Need."
      },
      {
        "id": "CONDITIONAL_TECHNICAL_VALIDITY",
        "required": true,
        "rule": "Technical assessment is required only when the current Evaluation Plan requires TECHNICAL_ASSESSOR or frozen profile hard keys include TECHNICAL_ASSESSMENT_VALID/HSE_AND_TECH_VALID."
      },
      {
        "id": "HARD_CONDITIONS",
        "required": true,
        "rule": "Every frozen profile hard condition must map to a known machine key and pass; unknown hard-condition text fails closed."
      },
      {
        "id": "SPECIALIST_OUTCOMES",
        "required": true,
        "rule": "Required assignments cannot contain FAIL/RETURN/NO_GO; HSE FAIL/RETURN is blocking."
      },
      {
        "id": "COMMITTEE_POSITIVE_RESULT",
        "requiredWhen": "decisionRoute == G04_COMMITTEE",
        "rule": "Wave 7 committee state must be COMPLETED and ApprovalRuleSatisfied=true against the exact frozen committee snapshot/version."
      },
      {
        "id": "SEPARATION_OF_DUTIES",
        "required": true,
        "rule": "Final authority cannot be a frozen committee member for the same assessment; evaluator/final-decider conflict is denied unless frozen governance explicitly allows ALLOW_WITH_AUDIT."
      }
    ]
  },
  "profileAndRuleFreeze": {
    "openAssessmentProfileSource": "CURRENT_ACTIVE_PROFILE",
    "freezeOccursAt": "FINAL_DECISION",
    "requiredFrozenEvidence": [
      "profileId",
      "profileVersion",
      "profileSnapshot",
      "profileSnapshotHash",
      "ruleSet",
      "hardConditionMappingVersion",
      "gateScore",
      "dataReadiness",
      "ideaVersion",
      "evaluationPlanId",
      "evaluationPlanVersion",
      "assessmentId",
      "frozenAt"
    ],
    "closedHistoryMayInferFromCurrentProfile": false
  },
  "committeeEvidenceForFinalDecision": {
    "requiredWhenRoute": "G04_COMMITTEE",
    "requiredForApprove": [
      "committeeSnapshotId",
      "committeeVersion",
      "votingStageState=COMPLETED",
      "approvalRuleSatisfied=true"
    ],
    "fullMemberSnapshotCopiedIntoIntegrationEvent": false,
    "voteNotesCopiedIntoIntegrationEvent": false
  },
  "immutableDecisionEvidence": {
    "appendOnly": true,
    "fields": [
      "decisionId",
      "assessmentId",
      "ideaId",
      "ideaVersionBefore",
      "ideaVersionAfter",
