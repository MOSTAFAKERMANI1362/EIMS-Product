  "decisionInput": {
    "commentRequired": true,
    "commentMinLength": 15,
    "reasonCodeRequired": true,
    "allowedReasonCodes": [
      "G04_READY",
      "G04_SOLUTION_INCOMPLETE",
      "G04_EVIDENCE_INCOMPLETE",
      "G04_COST_INCOMPLETE",
      "G04_RISK_UNRESOLVED",
      "G04_TECH_FAIL",
      "G04_ALIGNMENT",
      "OTHER"
