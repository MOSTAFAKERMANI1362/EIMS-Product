    "singleEffectiveRoleRequired": "IDEA_DECISION",
    "scopeMustContainIdeaScope": true,
    "clientMaySupplyPersonRoleScopeOrAssignmentAuthority": false,
    "committeeMemberMayBeFinalDeciderForSameAssessment": false,
    "committeeAndFinalDecisionAuthoritySeparated": true,
    "evaluatorConflictPolicy": {
      "appliesToOutcome": "APPROVE",
      "default": "DENY",
      "allowedException": "ALLOW_WITH_AUDIT",
